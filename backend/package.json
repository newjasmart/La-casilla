{
  "name": "la-casilla-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Supabase + Resend per a la casa d'hostes La Casilla",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:seed": "supabase db reset",
    "functions:serve": "supabase functions serve --env-file ./supabase/functions/.env",
    "functions:deploy": "supabase functions deploy",
    "functions:deploy:reservation": "supabase functions deploy send-reservation",
    "functions:deploy:contact": "supabase functions deploy send-contact",
    "secrets:set": "supabase secrets set --env-file ./supabase/functions/.env",
    "types:generate": "supabase gen types typescript --local > types/database.ts"
  },
  "devDependencies": {
    "supabase": "^1.200.3"
  }
}
