# Copiez vers .env.production. Ce fichier contient uniquement des placeholders.
# Ne commitez jamais .env.production.
EMAIL_DELIVERY_MODE=live
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="La Casilla <reserves@lacasillacasarural.com>"
RESEND_OWNER_EMAIL=marcbarriscosta@gmail.com
ANTI_SPAM_HASH_SECRET=remplacez-par-un-secret-aleatoire-d-au-moins-32-caracteres
ALLOWED_ORIGINS=https://lacasillacasarural.com,https://www.lacasillacasarural.com
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600
CASA_NOM=La Casilla
CASA_TELEFON=
CASA_ADRECA=
CASA_WEB=https://lacasillacasarural.com

# Stripe (payments) — LIVE keys, from a real, verified Stripe account.
# STRIPE_SECRET_KEY starts with sk_live_…, never sk_test_….
# STRIPE_WEBHOOK_SECRET comes from the live webhook endpoint you configure
# in the Stripe Dashboard (Developers -> Webhooks), pointing at
# https://<project-ref>.supabase.co/functions/v1/stripe-webhook — a
# separate signing secret from any test-mode one.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
