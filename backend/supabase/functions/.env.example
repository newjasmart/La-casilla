# DEV local: aucun appel Resend. Utilisez live uniquement dans un environnement configuré.
EMAIL_DELIVERY_MODE=mock
RESEND_API_KEY=unused-in-mock-mode
RESEND_FROM_EMAIL="La Casilla <reserves@lacasillacasarural.com>"
# Adresse réelle consultée par Marc pour les notifications.
RESEND_OWNER_EMAIL=marcbarriscosta@gmail.com
ANTI_SPAM_HASH_SECRET=canvieu-ho-per-un-secret-aleatori-de-32-caracters-o-mes
ALLOWED_ORIGINS=https://lacasillacasarural.com,https://www.lacasillacasarural.com
# Local opcional: afegiu http://localhost:3000,http://127.0.0.1:3000 explícitament.
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600
CASA_NOM=La Casilla
CASA_TELEFON=+34 600 000 000
CASA_ADRECA=Carrer Principal, 1 - 08000 Vall del Pirineu
CASA_WEB=https://lacasillacasarural.com
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Needed only by create-payment-link, to read a reservation AS the calling
# admin (so Postgres RLS — not our own code — is what checks they're staff).
# On a real hosted deployment this is auto-injected by Supabase and does NOT
# need to be set via `secrets:set`; it's only listed here for local dev,
# same as SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above. Find it with
# `supabase status` (the ANON_KEY line).
SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Stripe (payments) ---------------------------------------------------
# Both come from the Stripe Dashboard of a real Stripe account you create
# yourself (Claude cannot create one for you, nor should it ever see a real
# secret key). Use the TEST MODE keys while developing — they need no
# business verification and never move real money:
#   STRIPE_SECRET_KEY      Dashboard -> Developers -> API keys -> Secret key
#                          (starts with sk_test_… in test mode, sk_live_… once you go live)
#   STRIPE_WEBHOOK_SECRET  Dashboard -> Developers -> Webhooks -> add an
#                          endpoint pointing at .../functions/v1/stripe-webhook
#                          listening for checkout.session.completed and
#                          checkout.session.expired -> reveal its "Signing secret"
#                          (starts with whsec_…). For local testing, the
#                          Stripe CLI (`stripe listen --forward-to ...`)
#                          prints its own whsec_… to use instead.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
